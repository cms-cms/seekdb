# owner: fankun.fan
# owner group: vector
# description: keep unresolved async-index DML behind the change-stream refresh watermark

--disable_query_log
connect (conn_sys,$OBMYSQL_MS0,root@sys,,oceanbase,$OBMYSQL_PORT);
connect (conn_dml,$OBMYSQL_MS0,root@sys,,test,$OBMYSQL_PORT);

connection conn_sys;
alter system set vector_memory_limit = 0;
alter system set debug_sync_timeout = '100s';
set ob_global_debug_sync = 'reset';

connection conn_dml;
drop table if exists cs_refresh_guard;
drop table if exists cs_refresh_numbers;
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'cs_refresh_embed', '{
    "type": "dense_embedding",
    "model_name": "bge-M3"
  }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
  'cs_refresh_endpoint', '{
    "ai_model_name": "cs_refresh_embed",
    "scope": "all",
    "url": "http://127.0.0.1:1/unused",
    "access_key": "unused",
    "request_model_name": "bge-M3",
    "provider": "openai"
  }');
create table cs_refresh_guard(
  id bigint primary key,
  document varchar(4096),
  vector index idx_cs_refresh_guard(document)
    with (distance=l2, type=hnsw, model=cs_refresh_embed, dim=1024,
          sync_mode=async, sync_interval=20s)
);

# Materialize 64 source rows before the guarded transaction.  The later
# INSERT ... SELECT writes about 256 KiB into the async-index base table,
# comfortably above the 16 KiB transaction private-buffer threshold without
# making ChangeStream deserialize a needlessly large redo record.  Using a LOB
# payload here would only flush redo for the auxiliary LOB table, which
# ChangeStream intentionally ignores for this unresolved-transaction check.
create table cs_refresh_numbers(id bigint primary key);
insert into cs_refresh_numbers values (0);
insert into cs_refresh_numbers select id + 1 from cs_refresh_numbers;
insert into cs_refresh_numbers select id + 2 from cs_refresh_numbers;
insert into cs_refresh_numbers select id + 4 from cs_refresh_numbers;
insert into cs_refresh_numbers select id + 8 from cs_refresh_numbers;
insert into cs_refresh_numbers select id + 16 from cs_refresh_numbers;
insert into cs_refresh_numbers select id + 32 from cs_refresh_numbers;

connection conn_sys;
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT = 0 and REFRESH_SCN > 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc

connection conn_dml;
start transaction;
set session ob_query_timeout = 120000000;
insert into cs_refresh_guard
select id + 2, concat('pending async index row ', id, ' ', repeat('x', 4000))
from cs_refresh_numbers;
# The bounded inline base-table writes force at least one early redo block.
# Pause only this client transaction after its commit version is assigned but
# before its commit log is submitted.  CSFetcher remains runnable and must
# retain the unresolved user-DML transaction behind the watermark.
set debug_sync =
  'CS_TX_AFTER_GENERATE_COMMIT_VERSION wait_for cs_commit_continue execute 1';
send commit;

connection conn_sys;
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT > 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc

let $refresh_scn_before =
  `select REFRESH_SCN from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT`;
real_sleep 1;
let $refresh_scn_after =
  `select REFRESH_SCN from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT`;
if ($refresh_scn_before != $refresh_scn_after)
{
  die ChangeStream refresh SCN advanced past unresolved user DML;
}

set debug_sync = 'now signal cs_commit_continue';

connection conn_dml;
reap;
set debug_sync = 'CS_TX_AFTER_GENERATE_COMMIT_VERSION clear';

connection conn_sys;
set ob_global_debug_sync = 'reset';
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT = 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc

connection conn_dml;
--enable_query_log
--echo unresolved user DML kept behind refresh watermark
select count(*) as committed_rows from cs_refresh_guard where id between 2 and 65;
--disable_query_log
drop table cs_refresh_guard;
drop table cs_refresh_numbers;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('cs_refresh_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('cs_refresh_embed');
disconnect conn_dml;
disconnect conn_sys;
--enable_query_log
