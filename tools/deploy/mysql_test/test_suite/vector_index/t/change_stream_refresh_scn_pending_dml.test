# owner: fankun.fan
# owner group: vector
# description: keep unresolved async-index DML behind the change-stream refresh watermark

--disable_query_log
connect (conn_sys,$OBMYSQL_MS0,root@sys,,oceanbase,$OBMYSQL_PORT);
connect (conn_dml,$OBMYSQL_MS0,root@sys,,test,$OBMYSQL_PORT);

connection conn_sys;
alter system set vector_memory_limit = 0;
alter system set debug_sync_timeout = '100s';
set ob_global_debug_sync = 'reset';

connection conn_dml;
drop table if exists cs_refresh_guard;
call DBMS_AI_SERVICE.CREATE_AI_MODEL(
  'cs_refresh_embed', '{
    "type": "dense_embedding",
    "model_name": "bge-M3"
  }');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT(
  'cs_refresh_endpoint', '{
    "ai_model_name": "cs_refresh_embed",
    "scope": "all",
    "url": "http://127.0.0.1:1/unused",
    "access_key": "unused",
    "request_model_name": "bge-M3",
    "provider": "openai"
  }');
create table cs_refresh_guard(
  id bigint primary key,
  document varchar(4096),
  vector index idx_cs_refresh_guard(document)
    with (distance=l2, type=hnsw, model=cs_refresh_embed, dim=1024,
          sync_mode=async, sync_interval=20s)
);

connection conn_sys;
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT = 0 and REFRESH_SCN > 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc
# Force this one guarded write to submit redo before commit.  This existing
# transaction test point avoids depending on payload compression or the
# private-buffer threshold, and is disabled before the final commit starts.
alter system set_tp tp_name = "TX_FORCE_WRITE_CLOG", error_code = 4023, frequency = 1;

connection conn_dml;
start transaction;
insert into cs_refresh_guard values (2, 'pending user dml');

connection conn_sys;
alter system set_tp tp_name = "TX_FORCE_WRITE_CLOG", error_code = 4023, frequency = 0;

connection conn_dml;
# Pause only this client transaction after its commit version is assigned but
# before its commit log is submitted.  CSFetcher remains runnable and must
# retain the unresolved user-DML transaction behind the watermark.
set debug_sync =
  'CS_TX_AFTER_GENERATE_COMMIT_VERSION wait_for cs_commit_continue execute 1';
send commit;

connection conn_sys;
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT > 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc

let $refresh_scn_before =
  `select REFRESH_SCN from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT`;
real_sleep 1;
let $refresh_scn_after =
  `select REFRESH_SCN from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT`;
if ($refresh_scn_before != $refresh_scn_after)
{
  die ChangeStream refresh SCN advanced past unresolved user DML;
}

set debug_sync = 'now signal cs_commit_continue';

connection conn_dml;
reap;
set debug_sync = 'CS_TX_AFTER_GENERATE_COMMIT_VERSION clear';

connection conn_sys;
set ob_global_debug_sync = 'reset';
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT = 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc

connection conn_dml;
--enable_query_log
--echo unresolved user DML kept behind refresh watermark
select count(*) as committed_rows from cs_refresh_guard where id = 2;
--disable_query_log
drop table cs_refresh_guard;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('cs_refresh_endpoint');
call DBMS_AI_SERVICE.DROP_AI_MODEL('cs_refresh_embed');
disconnect conn_dml;
disconnect conn_sys;
--enable_query_log
