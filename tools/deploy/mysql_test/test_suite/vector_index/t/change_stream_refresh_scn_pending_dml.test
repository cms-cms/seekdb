# owner: fankun.fan
# owner group: vector
# description: keep unresolved async-index DML behind the change-stream refresh watermark

--disable_query_log
connect (conn_sys,$OBMYSQL_MS0,root@sys,,oceanbase,$OBMYSQL_PORT);
connect (conn_dml,$OBMYSQL_MS0,root@sys,,test,$OBMYSQL_PORT);

connection conn_sys;
alter system set vector_memory_limit = 0;
alter system set debug_sync_timeout = '100s';
set ob_global_debug_sync = 'reset';

connection conn_dml;
drop table if exists cs_refresh_guard;
create table cs_refresh_guard(
  id bigint primary key,
  payload longtext,
  embedding vector(3)
);
insert into cs_refresh_guard values(1, 'seed', '[0,0,0]');
create vector index idx_cs_refresh_guard on cs_refresh_guard(embedding)
  with (distance=l2, type=ivf_flat, nlist=1, sample_per_nlist=1);

connection conn_sys;
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT = 0 and REFRESH_SCN > 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc

connection conn_dml;
start transaction;
set session ob_query_timeout = 120000000;
insert into cs_refresh_guard values
  (2, repeat('a', 1048576), '[1,1,1]'),
  (3, repeat('b', 1048576), '[2,2,2]'),
  (4, repeat('c', 1048576), '[3,3,3]');
# Pause only this client transaction after the transaction service has
# assigned its commit version but before it submits the commit log.  The large
# redo has already been submitted separately and is visible to ChangeStream.
set debug_sync =
  'CS_TX_AFTER_GENERATE_COMMIT_VERSION wait_for cs_commit_continue execute 1';
send commit;

connection conn_sys;
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT > 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc

let $refresh_scn_before =
  `select REFRESH_SCN from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT`;
real_sleep 1;
let $refresh_scn_after =
  `select REFRESH_SCN from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT`;
if ($refresh_scn_before != $refresh_scn_after)
{
  die ChangeStream refresh SCN advanced past unresolved user DML;
}

set debug_sync = 'now signal cs_commit_continue';

connection conn_dml;
reap;
set debug_sync = 'CS_TX_AFTER_GENERATE_COMMIT_VERSION clear';

connection conn_sys;
set ob_global_debug_sync = 'reset';
let $wait_timeout = 60;
let $wait_condition =
  select PENDING_TX_COUNT = 0
  from oceanbase.DBA_OB_CHANGE_STREAM_REFRESH_STAT;
--source include/wait_condition.inc

connection conn_dml;
--enable_query_log
--echo commit-version window kept behind refresh watermark
select count(*) as committed_rows from cs_refresh_guard where id between 2 and 4;
--disable_query_log
drop table cs_refresh_guard;
disconnect conn_dml;
disconnect conn_sys;
--enable_query_log
